{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "docker:pinDigests"],
  "enabledManagers": ["gomod", "dockerfile", "github-actions"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["gomod", "dockerfile"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump",
      "groupName": "Go toolchain"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["golang"],
      "groupName": "Go toolchain"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["gomod"],
      "matchFileNames": [".github/tools/**"],
      "matchDepTypes": ["require", "indirect", "tool"],
      "groupName": "CI Go tools",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["gomod", "dockerfile"],
      "matchDepNames": ["go", "golang"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"],
      "groupName": "Container image digests",
      "automerge": true
    }
  ]
}
