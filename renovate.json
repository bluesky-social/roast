{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>bluesky-social/.github//renovate/default#v1"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchFileNames": [".github/tools/**"],
      "matchDepTypes": ["require", "indirect", "tool"],
      "groupName": "CI Go tools",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Actionlint requires the YAML rc.3 parser error API; let actionlint updates migrate this dependency.",
      "matchManagers": ["gomod"],
      "matchFileNames": [".github/tools/actionlint/go.mod"],
      "matchDepNames": ["go.yaml.in/yaml/v4"],
      "enabled": false
    }
  ]
}
